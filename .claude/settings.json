{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Write(applications/**)",
      "Edit(applications/**)",
      "Bash(.venv/bin/python -c \"import docx, yaml; print\\('ok'\\)\")",
      "Bash(.venv/bin/python scripts/generate_docx.py resume applications/*/resume.yaml applications/*/resume.docx)",
      "Bash(.venv/bin/python scripts/generate_docx.py cover-letter applications/*/cover_letter.yaml applications/*/cover_letter.docx)",
      "Skill(schedule)",
      "Skill(schedule:*)",
      "Read(~/Library/LaunchAgents/**)",
      "Bash(scripts/daily_run.sh)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ],
    "additionalDirectories": [
      "~/Library/LaunchAgents"
    ]
  }
}
